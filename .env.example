# FaultLens .NET sample configuration.
# Copy this file to `.env` and fill in the two required values. No source edits needed.
#   cp .env.example .env
#
# Required — from your FaultLens project setup:
FaultLens__ApiKey=YOUR_PROJECT_API_KEY
FaultLens__Endpoint=https://YOUR-WORKSPACE.faultlens.in

# Optional demo context (safe placeholder values shown):
FaultLens__Environment=production
FaultLens__Release=v1.8.4
FaultLens__ServiceName=checkout-api
FaultLens__ServiceVersion=v1.8.4+sample.1
FaultLens__TenantId=tenant_demo_retail
FaultLens__AccountId=acct_demo_standard
FaultLens__UserId=user_demo_123
FaultLens__AnonymousId=anon_demo_browser_456
